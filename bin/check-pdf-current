#!/usr/bin/env python3
"""Prove each committed PDF is the one its source builds.

    python3 bin/check-pdf-current                           # every paper
    python3 bin/check-pdf-current --paper software-factory  # one of them

Both papers are held to the same rules, from the one table in bin/papers.py. The
papers marked required there — both, now the reference architecture is
published — must have their PDF in the tree, with a manifest that describes it,
built from the source in the tree, and not as a draft. That
replaces the stand-in check bin/check-sf-pdf used to make, which refused one
known placeholder by its digest and would have passed any other wrong file.

This is the enforceable half of the reproducibility question, and it is the half
that matters on a pull request. The other half — do two builds of unchanged source
produce the same bytes — is bin/check-pdf-reproducible, which has to run the
browser and so can only run where that browser is. This one runs anywhere Python
runs: no Chrome, no pandoc, no node, about a tenth of a second. That is the whole
point of it. A gate nothing invokes is a note to self, and check-pdf-reproducible
was invoked by nothing at all — not CI, not a hook, not another script — because
it could not be: ubuntu-latest has neither pandoc nor a Chrome, and the committed
bytes carry the exact browser build and platform that produced them, so a rebuild
on a runner would differ from the committed file for reasons that have nothing to
do with the paper.

So the two questions are separated and each is asked where it can be answered:

  * did the artifact keep up with its source — here, on every pull request;
  * is the build deterministic — in bin/check-pdf-reproducible, on the toolchain
    that built it, and in the `determinism` CI job, which builds twice on a pinned
    browser and compares those two builds to each other.

The evidence is each paper's pdf.provenance.json (whitepaper/ and
software-factory/), which bin/build-pdf writes as it renders: the digest of every file the render actually read, the digest of the PDF
it produced, and the browser that produced it. Recorded by the build rather than
listed by hand, so adding a figure adds it to the manifest without anyone
remembering to.

What this does NOT prove, because it is worth being exact about a gate that runs
on every commit:

  * that the PDF renders correctly — check-appendix, check-figure and the
    off-sheet guard in bin/print-page.mjs are the ones that read the content;
  * that the manifest describes a build anyone can reproduce. It records the
    browser; it does not re-run it. Only check-pdf-reproducible does that.

It does prove that the paper's source, controls.yaml and contributors.yaml where
it reads them, the figures, the fonts and the scripts that turn them into a PDF
are all at the versions the committed PDF was made from — which is exactly "nobody edited the paper and
forgot to rebuild", and "nobody hand-patched the PDF".

That proof is only as good as the list of inputs it is checked against, and that
list used to be the manifest's own. A manifest is checked against what it
records, so one that recorded the wrong paper's inputs, or none, was checked
against the wrong things or nothing: the white paper built to the reference
architecture's paths passed as the reference architecture, and kept passing while
software-factory.md was edited; a hand-written manifest with `"inputs": {}`
passed for any file. So the inputs a manifest must record are now also computed
from the tree, independently of the manifest — the paper's own source, every
figure it references, the four files that render it, every font face the build
embeds and, for the white paper, the catalogue its appendix is generated from —
and a manifest that leaves one out, names another paper, records no browser or
no pages is refused before any digest is compared.
"""
import argparse, ast, hashlib, json, pathlib, re, sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from papers import PAPERS

ROOT = pathlib.Path(__file__).resolve().parents[1]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def pdf_string(blob, key):
    m = re.search(rb"/" + key.encode() + rb"\s*\((.*?)(?<!\\)\)", blob, re.S)
    return re.sub(r"\\([()\\])", r"\1", m.group(1).decode("latin1")) if m else ""


def rel(p):
    return p.relative_to(ROOT).as_posix()


def rebuild(name):
    paper = PAPERS[name]
    flag = "" if name == "whitepaper" else f" --paper {name}"
    return (f"Run `python3 bin/build-pdf{flag}` and commit {rel(paper['out'])} together "
            f"with {rel(paper['provenance'])}.")


# ── what a manifest for this paper must record, computed from the tree ───────
# The floor, not the whole list: the build records everything it opens, and a
# manifest may name more than this. It may not name less. Each entry is here
# because leaving it out is a way to pass the wrong PDF: the source ties the
# manifest to its paper, the figures and fonts are drawn into the page, and the
# four scripts are the stylesheet, the cover, the normalisation, the table of
# papers and the paginator.
SCRIPTS = ("bin/build-pdf", "bin/print-page.mjs", "bin/papers.py",
           "bin/vendor/paged.polyfill.js")
# What one paper reads that the other does not. The white paper's Appendix A is
# generated from the catalogue, by the reader in controls_source.py. Each paper's
# contributors.yaml decides who its cover may name, so a manifest that left it out
# stayed "current" after a contributor in the byline was withdrawn.
EXTRA = {"whitepaper": ("whitepaper/controls.yaml", "bin/controls_source.py",
                        "whitepaper/contributors.yaml"),
         "software-factory": ("software-factory/contributors.yaml",)}
# An image's alt text or caption, allowing one level of nested brackets.
ALT = r"!\[((?:[^\[\]]|\[[^\[\]]*\])*)\]"


def faces():
    """The font files bin/build-pdf embeds, from its FACES table, or None.

    Parsed rather than imported, so this check never runs the build to learn
    what the build reads. A table that has moved or changed shape is None, which
    the caller reports: a font floor that silently became empty is the gap this
    closes.
    """
    for node in ast.parse((ROOT / "bin" / "build-pdf").read_text(encoding="utf-8")).body:
        targets = (node.targets if isinstance(node, ast.Assign) else
                   [node.target] if isinstance(node, ast.AnnAssign) else [])
        if not any(isinstance(t, ast.Name) and t.id == "FACES" for t in targets):
            continue
        try:
            rows = ast.literal_eval(node.value)
        except ValueError:
            return None
        if not rows or not all(isinstance(r, tuple) and r and isinstance(r[-1], str)
                               for r in rows):
            return None
        return sorted({f"static/fonts/{r[-1]}" for r in rows})
    return None


def figures(src):
    """(repo paths, problems): every image the paper's source references.

    Read from the markdown, since this check runs without pandoc: inline images,
    reference-style images and raw <img> tags. Comments and fenced code are not
    rendered, so what is in them is not read by the build either. A target with
    a colon is a URL, which bin/build-pdf leaves alone, so it is skipped here too.
    """
    text = src.read_text(encoding="utf-8")
    text = re.sub(r"<!--.*?-->", " ", text, flags=re.S)
    text = re.sub(r"^ {0,3}(`{3,}|~{3,}).*?^ {0,3}\1", " ", text, flags=re.S | re.M)
    defs = {k.strip().lower(): v for k, v in
            re.findall(r"^ {0,3}\[([^\]]+)\]:[ \t]*<?([^\s>]+)", text, re.M)}
    targets = [t for _, t in re.findall(ALT + r"\(\s*<?([^\s)>]+)", text)]
    for alt, label in re.findall(ALT + r"(?!\()(?:\[([^\]]*)\])?", text):
        key = (label or alt).strip().lower()
        if key in defs:
            targets.append(defs[key])
    targets += re.findall(r"<img\b[^>]*?\bsrc=[\"']([^\"']+)[\"']", text, re.I)

    found, problems = [], []
    for t in targets:
        if ":" in t:
            continue
        p = (src.parent / t).resolve()
        if ROOT not in p.parents:
            problems.append(f"{rel(src)} references {t}, which is outside the repository, "
                            f"so no manifest can record it and nothing here can say whether "
                            f"the PDF's copy of it is current.")
        else:
            found.append(rel(p))
    return found, problems


def floor(name):
    """(the inputs a manifest of this paper must record, problems computing them)."""
    src = PAPERS[name]["src"]
    need, problems = [rel(src)], []
    if src.exists():
        figs, bad = figures(src)
        need += figs
        problems += bad
    else:
        problems.append(f"{rel(src)} is missing, so neither the paper nor the figures it "
                        f"references can be required of the manifest.")
    need += SCRIPTS
    fonts = faces()
    if fonts is None:
        problems.append("bin/build-pdf has no FACES table this check can read, so the font "
                        "faces the PDF embeds cannot be required of its manifest. Refusing "
                        "rather than checking less: update faces() in bin/check-pdf-current "
                        "to wherever the table now lives.")
    else:
        need += fonts
    need += EXTRA.get(name, ())
    return list(dict.fromkeys(need)), problems


def identity(name, manifest):
    """Problems that make this manifest not a description of this paper's build.

    Asked before any digest, because digests only prove that a manifest agrees
    with the files it names. These prove it names this paper's files. Shared with
    bin/check-pdf-reproducible, which must not rebuild against a manifest that
    describes something else and then diagnose the difference as nondeterminism.
    """
    paper = PAPERS[name]
    prov, out, REBUILD = rel(paper["provenance"]), rel(paper["out"]), rebuild(name)

    # The manifest names its own artifact. A manifest written by a build that
    # went somewhere else (`--out` a scratch path) and was then copied into place
    # describes that other file, not this one.
    if manifest.get("artifact") != out:
        return [f"{prov} describes {manifest.get('artifact')!r}, not {out} — it was "
                f"written by a build to another path and copied in. {REBUILD}"]
    # A draft accepts figures whose alt text is unwritten and stamps every page.
    # bin/build-pdf refuses to write one to the tracked path; this catches one
    # that arrived by a copy.
    if manifest.get("draft"):
        return [f"{out} is a draft build (figures' alt text unwritten, every page "
                f"stamped). {REBUILD}"]

    problems = []
    if "paper" in manifest and manifest["paper"] != name:
        problems.append(f"{prov} says it is the manifest of {manifest['paper']!r}, not of "
                        f"{name!r}. {REBUILD}")
    by = manifest.get("built_by")
    if not (isinstance(by, dict) and all(isinstance(by.get(k), str) and by[k].strip()
                                         for k in ("producer", "creator"))):
        problems.append(f"{prov} does not say which browser built {out}: `built_by` needs "
                        f"a producer and a creator. The build reads both back out of the "
                        f"PDF it wrote, so a manifest without them was not written by the "
                        f"build. {REBUILD}")
    pages = manifest.get("pages")
    if not (isinstance(pages, int) and not isinstance(pages, bool) and pages > 0):
        problems.append(f"{prov} records {pages!r} pages. A build that wrote a PDF wrote at "
                        f"least one page. {REBUILD}")
    if not (isinstance(manifest.get("bytes"), int)
            and re.fullmatch(r"[0-9a-f]{64}", str(manifest.get("sha256", "")))):
        problems.append(f"{prov} has no `bytes` and `sha256` for {out}, so nothing ties it "
                        f"to the file. {REBUILD}")
    inputs = manifest.get("inputs")
    if not isinstance(inputs, dict):
        problems.append(f"{prov} has no `inputs` table. {REBUILD}")
        inputs = {}

    need, bad = floor(name)
    problems += bad
    missing = [r for r in need if r not in inputs]
    if missing:
        problems.append(f"These are inputs of the {name} build, computed from the tree, and "
                        f"{prov} does not record them:\n" +
                        "".join(f"    {r}\n" for r in missing) +
                        "  A manifest is checked only against what it records, so one that "
                        "leaves out the paper's source, its figures, its fonts or the files "
                        "that render it can call a PDF of something else current. " + REBUILD)
    foreign = [rel(PAPERS[o][k]) for o in PAPERS if o != name
               for k in ("src", "out", "provenance") if rel(PAPERS[o][k]) in inputs]
    if foreign:
        problems.append(f"{prov} records another paper's files as inputs:\n" +
                        "".join(f"    {r}\n" for r in foreign) +
                        f"  It describes a build of that paper, not of {name}. {REBUILD}")
    return problems


def check(name):
    """(problems, report) for one paper. report is printed when there are none."""
    paper = PAPERS[name]
    provenance, out = paper["provenance"], paper["out"]
    REBUILD = rebuild(name)

    if not provenance.exists():
        if not paper["required"] and not out.exists():
            # Absent together is a state the site handles: the links are guarded
            # with fileExists and disappear with the file.
            return [], [f"pdf: {rel(out)} absent — its links are fileExists-guarded "
                        f"and will not render"]
        if out.exists():
            return [f"{rel(out)} is in the tree with no manifest ({rel(provenance)}), so "
                    f"nothing says what source it was built from. A placeholder, a "
                    f"hand-placed file or a manifest left out of a commit all look like "
                    f"this. {REBUILD}"], []
        return [f"{rel(provenance)} is missing, so there is nothing to check the "
                f"artifact against. {REBUILD}"], []

    try:
        manifest = json.loads(provenance.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        return [f"{rel(provenance)} is not readable JSON: {e}"], []
    if not isinstance(manifest, dict):
        return [f"{rel(provenance)} is not a manifest (a JSON object). {REBUILD}"], []

    wrong = identity(name, manifest)
    if wrong:
        return wrong, []

    PDF = ROOT / manifest["artifact"]
    if not PDF.exists():
        return [f"{manifest['artifact']} is missing — the manifest describes an "
                f"artifact that is not in the tree. {REBUILD}"], []

    problems = []

    # ── 1 · every recorded input is still at the version that was rendered ────
    # Reported as a list rather than on the first mismatch: "whitepaper.md and two
    # figures moved" is a different situation from "a font was replaced", and seeing
    # only the first of them sends the reader looking in one place for one of several
    # reasons the artifact is behind.
    moved, gone = [], []
    for r, digest in manifest["inputs"].items():
        p = ROOT / r
        if not p.exists():
            gone.append(r)
        elif sha(p) != digest:
            moved.append(r)

    if gone:
        problems.append("These inputs are recorded in the manifest but no longer exist:\n" +
                        "".join(f"    {r}\n" for r in gone) +
                        "  Either they were deleted and the PDF still contains them, or the "
                        "manifest is from a different tree.")
    if moved:
        problems.append("These inputs have changed since the committed PDF was built:\n" +
                        "".join(f"    {r}\n" for r in moved) +
                        f"  The PDF in the tree is stale. {REBUILD}" +
                        ("\n  Note that the paper's `# Contents` and `# Appendix A` are "
                         "regenerated by the build, so an edit confined to those will "
                         "produce an identical PDF and a new manifest. Commit both."
                         if name == "whitepaper" else ""))

    # ── 2 · the artifact itself is the one the manifest describes ────────────
    blob = PDF.read_bytes()
    if len(blob) != manifest["bytes"] or sha(PDF) != manifest["sha256"]:
        detail = (f"{len(blob):,} bytes, sha256 {sha(PDF)[:16]}…\n"
                  f"    manifest says {manifest['bytes']:,} bytes, "
                  f"sha256 {manifest['sha256'][:16]}…")
        if moved or gone:
            problems.append(f"{manifest['artifact']} also does not match the manifest:\n"
                            f"    {detail}")
        else:
            # Nothing the build reads has moved, so a changed artifact was not produced
            # by this source. Something wrote to the PDF directly.
            problems.append(
                f"{manifest['artifact']} does not match the manifest, but every input "
                f"the build reads is unchanged:\n    {detail}\n"
                f"  The PDF was modified without the source moving — a hand-patch, a "
                f"partial checkout, a merge that took the artifact from one side and the "
                f"manifest from the other, or a build on a different browser. Compare "
                f"`built_by` in the manifest with what your Chrome reports. {REBUILD}")

    # ── 3 · the manifest is describing this PDF, not a previous one ──────────
    # The digests above would already catch a mismatched pair. This reads the two
    # toolchain strings back out of the artifact so that when they disagree the
    # message can say which browser, rather than leaving a reviewer to diff a
    # megabyte of binary to find out.
    # `built_by` is required above, so an artifact that carries no such string,
    # or a different one, is a mismatch rather than nothing to compare.
    for key in ("producer", "creator"):
        want = manifest["built_by"][key]
        got = pdf_string(blob, key.capitalize())
        if want != got:
            problems.append(f"the artifact's /{key.capitalize()} is not the one recorded:\n"
                            f"    manifest: {want}\n"
                            f"    artifact: {got or '(none)'}\n"
                            f"  The committed PDF and the committed manifest came from "
                            f"different builds. {REBUILD}")

    return problems, [
        f"pdf: current · {manifest['artifact']} · {manifest['bytes']:,} bytes · "
        f"{manifest['pages']} pages · {len(manifest['inputs'])} inputs verified",
        f"     built by {manifest['built_by']['producer']}"]


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--paper", choices=sorted(PAPERS), action="append",
                    help="check only this paper (repeatable; default: every paper)")
    names = ap.parse_args().paper or list(PAPERS)
    failed = False
    for name in names:
        problems, report = check(name)
        if problems:
            failed = True
            print(f"pdf: {name} NOT current — {len(problems)} problem(s)\n", file=sys.stderr)
            for p in problems:
                print(f"  {p}\n", file=sys.stderr)
        else:
            print("\n".join(report))
    sys.exit(1 if failed else 0)
