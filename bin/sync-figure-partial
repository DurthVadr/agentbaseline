#!/usr/bin/env python3
"""Emit the inlined partials from the standalone figures.

The standalone files keep fixed ink so the PDF, the social card and any slide
export are byte-identical. The partials swap ink for CSS custom properties, so
on the web the figures take the page's colours instead of sitting on it as
plates. One source, two renderings, both generated.

Two variants: the wide composition and a vertical one for narrow viewports.
Scaling the wide drawing down makes every label microscopic, so the narrow
version is a different composition of the same relationships, generated from the
same names and roles.

Two papers. The first paper's Figure 1 (whitepaper/figures) becomes
layouts/partials/figure-1(-narrow).svg exactly as it always has. The software
factory's figures (software-factory/figures/figure-N.svg, and figure-N-narrow.svg
where there is one) become layouts/partials/sf-figure-N(-narrow).svg with the
same --fig-* tokens. Those figures also have a wash (untrusted agent execution)
and numerals knocked out of the accent, so they add --fig-wash and --fig-plate;
and because a page may set no --fig-* token at all, every var() in them falls
back to the page's own token for the same role. A fixed ink with no token stops
the sync rather than shipping a colour that cannot follow the theme.
"""
import re, pathlib

ROOT = pathlib.Path(__file__).resolve().parents[1]
NAMES = {"DIS": "discover", "AUT": "authorize", "CON": "constrain",
         "VAL": "validate", "OBS": "observe", "RES": "respond"}
TOKENS = [("#1A1C1A", "--fig-ink"), ("#5A5E5A", "--fig-soft"),
          ("#797D79", "--fig-faint"), ("#E4E5E1", "--fig-hair"),
          ("#CBCDC8", "--fig-rule"), ("#1A4D8F", "--fig-accent")]

for name in ("figure-1", "figure-1-narrow"):
    src = ROOT / "whitepaper" / "figures" / f"{name}.svg"
    if not src.exists():
        continue
    s = src.read_text(encoding="utf-8")
    s = re.sub(r'\swidth="\d+"\s+height="\d+"', "", s, count=1)
    for fixed, token in TOKENS:
        s = s.replace(f'"{fixed}"', f'"var({token})"')
    s = re.sub(r'<rect width="\d+" height="\d+" fill="#[0-9A-Fa-f]+"/>\n?\s*', "", s, count=1)
    s = re.sub(r'<text[^>]*>((?:DIS|AUT|CON|VAL|OBS|RES))-01…\d\d</text>',
               lambda m: f'<a href="/controls#{NAMES[m.group(1)]}">{m.group(0)}</a>', s)
    (ROOT / "layouts" / "partials" / f"{name}.svg").write_text(s, encoding="utf-8")
    print(f"wrote layouts/partials/{name}.svg")

# ── the software factory ─────────────────────────────────────────────────────
# figkit's inks, plus the accent these figures carry in fixed ink (the site's
# olive), the wash, the tint that marks what a level adds (--fig-new), and the
# plate the numerals knock out to; each falls back to
# the page token that plays the same part. Kept apart from the loop above so the
# first paper's partials cannot change because of anything below.
SF_TOKENS = [("#1A1C1A", "--fig-ink", "--ink"), ("#5A5E5A", "--fig-soft", "--soft"),
             ("#797D79", "--fig-faint", "--faint"), ("#E4E5E1", "--fig-hair", "--line"),
             ("#CBCDC8", "--fig-rule", "--baseline"), ("#8F8A7C", "--fig-rule", "--baseline"),
             ("#5A7A00", "--fig-accent", "--accent"),
             ("#F1F2EC", "--fig-wash", "--wash"), ("#DCE4BE", "--fig-new", "--wash"),
             ("#FFFFFF", "--fig-plate", "--paper")]
SF = ROOT / "software-factory" / "figures"
for src in (sorted(SF.glob("figure-*.svg")) if SF.exists() else []):
    if not re.fullmatch(r"figure-\d+(-narrow)?", src.stem):
        continue
    s = src.read_text(encoding="utf-8")
    s = re.sub(r'\swidth="\d+"\s+height="\d+"', "", s, count=1)
    s = re.sub(r'<rect width="\d+" height="\d+" fill="#[0-9A-Fa-f]+"/>\n?\s*', "", s, count=1)
    for fixed, token, page in SF_TOKENS:
        s = s.replace(f'"{fixed}"', f'"var({token},var({page}))"')
    # One accessible name, the alt text, as an <img>'s alt would give. The
    # standalone SVG names itself by title and desc together, which on the page
    # read the description twice and repeated the visible figcaption; naming it
    # by the desc alone still leaves Chrome exposing the desc a second time as
    # the description (tested in its accessibility tree). So the partial drops
    # <title> (the figcaption carries the caption) and <desc>, and names the
    # drawing with aria-label. The committed SVG keeps both; check-copy holds
    # them to the paper.
    _desc = re.search(r'<desc id="[^"]+">(.*?)</desc>\n?\s*', s, re.S)
    if not _desc:
        raise SystemExit(f"{src.name}: no <desc>, so no alt text to name the drawing by")
    _alt = " ".join(_desc.group(1).split()).replace('"', "&quot;")
    s = re.sub(r'<title id="[^"]+">.*?</title>\n?\s*', "", s, count=1, flags=re.S)
    s = s.replace(_desc.group(0), "", 1)
    s = re.sub(r'aria-labelledby="[^"]+"', f'aria-label="{_alt}"', s, count=1)
    left = sorted(set(re.findall(r'"#[0-9A-Fa-f]{6}"', s)))
    if left:
        raise SystemExit(f"{src.name}: fixed ink with no token: {', '.join(left)}")
    out = ROOT / "layouts" / "partials" / f"sf-{src.stem}.svg"
    out.write_text(s, encoding="utf-8")
    print(f"wrote layouts/partials/{out.name}")

# Every id in every software factory partial is unique across all of them, and
# every url(#…) and aria reference resolves inside its own drawing. The page
# inlines several figures (and both compositions of each, one hidden); a shared
# id makes url(#…) resolve to the first copy, which may be the hidden one.
_sf_parts = sorted((ROOT / "layouts" / "partials").glob("sf-figure-*.svg"))
_seen, _bad = {}, []
for _p in _sf_parts:
    _s = _p.read_text(encoding="utf-8")
    _ids = re.findall(r'\sid="([^"]+)"', _s)
    for _i in _ids:
        if _i in _seen:
            _bad.append(f"id {_i!r} in {_p.name} is also in {_seen[_i]}")
        _seen.setdefault(_i, _p.name)
    for _r in re.findall(r'url\(#([^)]+)\)', _s) + re.findall(r'aria-(?:labelledby|describedby)="([^"]+)"', _s):
        for _ref in _r.split():
            if _ref not in _ids:
                _bad.append(f"{_p.name} refers to #{_ref}, which it does not define")
if _bad:
    raise SystemExit("software factory partials:\n  " + "\n  ".join(_bad))
print(f"ids unique across {len(_sf_parts)} software factory partials ({len(_seen)} ids)")
