#!/usr/bin/env python3
"""Hold static/software-factory.pdf to its source, the way the white paper's is held.

This is bin/check-pdf-current for this paper, under the name CI runs it by. The
PDF is published, so it is required (bin/papers.py): an absent PDF fails. It
must have software-factory/pdf.provenance.json describing it, every input
recorded there must be unchanged, and it must not be a draft. The manifest must
also record this paper's own inputs — software-factory.md, every figure it
references, the files that render it and the fonts it embeds — which are
computed from the tree, not taken from the manifest: a manifest always matches
itself, so the white paper built to this paper's paths would otherwise pass
here. A PDF with no manifest is refused like any other unexplained file.
"""
import os, pathlib, sys

check = pathlib.Path(__file__).resolve().with_name("check-pdf-current")
os.execv(sys.executable, [sys.executable, str(check), "--paper", "software-factory"])
