#!/usr/bin/env python3
"""Generate static/social-card.png (1200x630): the wordmark and the tenets.

The card is the site's hero in miniature: outlined "Agent", solid "Baseline",
the four tenets on their connector rule, and one line of substance. The self-
hosted woff2 subsets are embedded as data URIs so headless Chrome renders the
real faces with no network and no font fallback drift.

The figure used to sit here and no longer does. It left the page, so a preview
showing it advertised something the page does not contain — and at the size a
feed renders an unfurl, six cards of 8pt labels are noise rather than
information. An unfurl has one job, which is to be legible at thumbnail size.
"""
import base64, pathlib, subprocess, sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import controls_source

ROOT = pathlib.Path(__file__).resolve().parents[1]

# The count was typed into the SVG. It said 33 for the whole of the day the
# catalogue became 35, on the og:image — the one asset nobody looks at again
# after they make it, and the one every share of this link renders. Derived
# from the source of truth so it cannot be wrong twice.
#
# Derived through the same counter Hugo's card filename has to match, because
# deriving it separately only moved the failure: this counted `[A-Z]{3}-\d{2}`
# and social-meta.html counts YAML list entries, so a three-digit identifier
# wrote social-card-34.png while the og:image pointed at social-card-35.png.
N_CONTROLS = controls_source.catalogue_size()

# `--paper software-factory` writes the second paper's card instead. Same sheet,
# same faces, same marks; the paper's name, its title block and its four
# boundaries in place of the wordmark and the tenets, with Agent Baseline named
# first as what it applies. Nothing about the baseline's card changes.
PAPER_ARG = sys.argv[sys.argv.index("--paper") + 1] if "--paper" in sys.argv else None
if PAPER_ARG not in (None, "software-factory"):
    sys.exit(f"unknown paper {PAPER_ARG!r}: expected software-factory")

def face(family, style, weight, fname):
    data = base64.b64encode((ROOT / "static" / "fonts" / fname).read_bytes()).decode()
    return (f"@font-face{{font-family:'{family}';font-style:{style};"
            f"font-weight:{weight};src:url(data:font/woff2;base64,{data}) "
            f"format('woff2');}}")

fonts = "".join([
    face("Figtree", "normal", "300 900", "figtree-normal-400-latin.woff2"),
    face("Chakra Petch", "normal", "500", "chakra-petch-normal-500-latin.woff2"),
    face("IBM Plex Serif", "normal", "400", "ibm-plex-serif-normal-400-latin.woff2"),
    face("IBM Plex Mono", "normal", "400", "ibm-plex-mono-normal-400-latin.woff2"),
])

INK, SOFT, FAINT, BASE, PAPER = "#221F18", "#5C5850", "#736E60", "#D9D4C6", "#FBF9F3"
# the light theme's accent, matching --accent in layouts/index.html
ACCENT = "#5A7A00"
HEAD = "Figtree,'Avenir Next','Helvetica Neue',sans-serif"
MONO = "'IBM Plex Mono',ui-monospace,Menlo,monospace"

# wordmark geometry: Figtree 600 measures 2.794em for "Agent" (tracking -0.02em
# brings it to ~2.7em); at 68px that puts "Baseline" at x ≈ 60 + 184 + 16
card = f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <style>{fonts}</style>
  <rect width="1200" height="630" fill="{PAPER}"/>

  <!-- registration marks, the sheet's own device, quarter size -->
  <g fill="none" stroke="{BASE}" stroke-width="1">
    <path d="M40 74 v-34 h34 M1126 40 h34 v34 M40 556 v34 h34 M1126 590 h34 v-34"/>
  </g>

  <text x="80" y="322" font-family="{HEAD}" font-size="100" font-weight="600"
    letter-spacing="-2" fill="none" stroke="{INK}" stroke-width="1.8">Agent</text>
  <text x="376" y="322" font-family="{HEAD}" font-size="100" font-weight="600"
    letter-spacing="-2" fill="{INK}">Baseline</text>
  <line x1="856" y1="322" x2="1120" y2="322" stroke="{BASE}" stroke-width="1"/>

  <text x="80" y="404" font-family="{HEAD}" font-size="23" font-weight="500"
    fill="{SOFT}">Identify the agent.<tspan fill="{FAINT}">&#160;&#160;·&#160;&#160;</tspan>Bound its authority.<tspan fill="{FAINT}">&#160;&#160;·&#160;&#160;</tspan>Control its actions.<tspan fill="{FAINT}">&#160;&#160;·&#160;&#160;</tspan>Prove its outcomes.</text>

  <!-- the connector rule and its four pips, as on the page -->
  <line x1="96" y1="436" x2="1064" y2="436" stroke="{BASE}" stroke-width="1"/>
  <g fill="{PAPER}" stroke="{ACCENT}" stroke-width="1.6">
    <circle cx="96" cy="436" r="4.5"/><circle cx="418" cy="436" r="4.5"/>
    <circle cx="740" cy="436" r="4.5"/><circle cx="1064" cy="436" r="4.5"/>
  </g>

  <text x="80" y="562" font-family="{MONO}" font-size="15"
    fill="{FAINT}">Six security outcomes &#183; {N_CONTROLS} controls &#183; versioned in the open</text>
  <text x="1120" y="562" text-anchor="end" font-family="{MONO}" font-size="15"
    fill="{FAINT}">agentbaseline.org &#183; v1.0-draft</text>
</svg>'''

if PAPER_ARG == "software-factory":
    import re
    src = (ROOT / "software-factory" / "software-factory.md").read_text(encoding="utf-8")
    m = re.search(r"^Version (\S+), ([A-Z][a-z]+) (\d{1,2}), (\d{4})$", src, re.M)
    if not m:
        sys.exit("software-factory.md: no \"Version N, Month D, YYYY\" line to put on the card")
    SF_VERSION, SF_DATE = m.group(1), f"{m.group(3)} {m.group(2)} {m.group(4)}"
    LABEL = "'Chakra Petch','Avenir Next',sans-serif"
    def cell(x, label, value, w):
        return (f'<text x="{x}" y="456" font-family="{LABEL}" font-size="13" font-weight="500" '
                f'letter-spacing="1.6" fill="{FAINT}">{label}</text>'
                f'<text x="{x}" y="486" font-family="{MONO}" font-size="19" fill="{INK}">{value}</text>')
    marks = ""
    for i, (n, name) in enumerate([("1", "Identity and access"), ("2", "Supply chain"),
                                   ("3", "Sandbox"), ("4", "Network")]):
        x = 80 + i * 262
        marks += (f'<circle cx="{x + 11}" cy="555" r="11" fill="{ACCENT}"/>'
                  f'<text x="{x + 11}" y="560" text-anchor="middle" font-family="{MONO}" '
                  f'font-size="13" font-weight="600" fill="{PAPER}">{n}</text>'
                  f'<text x="{x + 30}" y="561" font-family="{HEAD}" font-size="19" '
                  f'font-weight="600" fill="{INK}">{name}</text>')
    card = f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <style>{fonts}</style>
  <rect width="1200" height="630" fill="{PAPER}"/>
  <g fill="none" stroke="{BASE}" stroke-width="1">
    <path d="M40 74 v-34 h34 M1126 40 h34 v34 M40 556 v34 h34 M1126 590 h34 v-34"/>
  </g>
  <text x="80" y="128" font-family="{LABEL}" font-size="17" font-weight="500"
    letter-spacing="2.4" fill="{SOFT}"><tspan fill="{ACCENT}">AGENT BASELINE</tspan>, APPLIED TO THE SOFTWARE FACTORY</text>
  <text x="80" y="244" font-family="{HEAD}" font-size="72" font-weight="600"
    letter-spacing="-1.4" fill="{INK}">The Secure Software Factory</text>
  <text x="80" y="326" font-family="{HEAD}" font-size="72" font-weight="600"
    letter-spacing="-1.4" fill="{SOFT}">A Reference Architecture</text>
  <line x1="80" y1="420" x2="1120" y2="420" stroke="{BASE}" stroke-width="1"/>
  {cell(80, "BUILDS ON", "Agent Baseline", 0)}
  <line x1="390" y1="420" x2="390" y2="506" stroke="{BASE}" stroke-width="1"/>
  {cell(412, "VERSION", SF_VERSION, 0)}
  <line x1="560" y1="420" x2="560" y2="506" stroke="{BASE}" stroke-width="1"/>
  {cell(582, "PUBLISHED", SF_DATE, 0)}
  <line x1="80" y1="506" x2="1120" y2="506" stroke="{BASE}" stroke-width="1"/>
  {marks}
</svg>'''

tmp = ROOT / "whitepaper" / "figures" / ".social.svg"
tmp.write_text(card, encoding="utf-8")

chrome = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Written under two names on purpose. The versioned one is what the pages point
# at, so a changed count changes the URL and defeats the platforms' og:image
# caches — correcting the bytes in place would leave the old number in every
# preview already fetched. The plain name stays because previews posted before
# this resolve it, and a correct card at the old URL beats a 404.
out = ROOT / "static" / ("social-card.png" if PAPER_ARG is None
                         else f"social-card-software-factory-v{SF_VERSION}.png")
out.parent.mkdir(exist_ok=True)
if not pathlib.Path(chrome).exists():
    tmp.unlink(missing_ok=True)
    sys.exit("chrome not found — social card not regenerated")
r = subprocess.run([chrome, "--headless", "--disable-gpu", "--hide-scrollbars",
                    "--virtual-time-budget=3000",
                    f"--screenshot={out}", "--window-size=1200,630",
                    "--default-background-color=FFFFFFFF", tmp.as_uri()],
                   capture_output=True)
if r.returncode != 0:
    sys.exit(f"chrome failed ({r.returncode}): {r.stderr.decode()[:400]}")
tmp.unlink(missing_ok=True)
if PAPER_ARG is not None:
    # Versioned by the paper's version, so a new version is a new URL and the
    # platforms' og:image caches can't keep showing the old one.
    print(f"wrote {out.name}  ({out.stat().st_size:,} bytes)" if out.exists() else "social card FAILED")
    sys.exit(0)
versioned = ROOT / "static" / f"social-card-{N_CONTROLS}.png"
versioned.write_bytes(out.read_bytes())
print(f"wrote social-card.png + {versioned.name}  ({out.stat().st_size:,} bytes)"
      if out.exists() else "social card FAILED")
