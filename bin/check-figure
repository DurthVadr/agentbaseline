#!/usr/bin/env python3
"""
Visual regression gate for Figure 1.

Two earlier revisions shipped with colliding labels and a band running underneath
a terminal, and both passed a clean build. This checks the geometry the build
cannot see:

  1. no two text runs overlap
  2. no text run escapes the canvas
  3. every text run sits inside some box, not floating over a boundary
  4. the identifier ranges match controls.yaml

Run after every figure change. bin/snapshot does it automatically.

  bin/check-figure                 the first paper's Figure 1
  bin/check-figure figure-1-narrow a figure in whitepaper/figures, by name
  bin/check-figure path/to/x.svg   any generated figure, by path (the box
                                   manifest .x.boxes.json sits beside it)

A figure that is drawn in boxes — the software factory's — also writes
.x.geom.json, its shapes and connectors, and is held to the checks such a
figure needs on top of 1–4. They read only that manifest, so they cannot change
what the first paper's figures are held to:

  5. text never straddles a box edge: it is inside a box or clear of it
  6. no connector is drawn through text, a card, or another connector
  7. every connector starts and ends on something — no arrow lands in air
  8. an arrow's last leg is long enough to read as an arrow
  9. text stays legible at every size the figure is shown, whatever the
     figure's own data says: 7 pt at the PDF's figure width, and 10 px at the
     narrowest width the page shows it (a phone's 343 px column for a narrow
     variant, or for a wide figure that has none; the page's narrowest wide
     slot otherwise). The widths are measured facts, set below.
 10. nothing touches the canvas edge: every box, text run and connector keeps
     at least 6 units of air, so no stroke is clipped and every figure sits
     in the same margin
"""
import json, re, sys, pathlib

HERE = pathlib.Path(__file__).resolve().parents[1] / "whitepaper"
NAME = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else "figure-1"
BOXES = HERE / "figures" / f".{NAME}.boxes.json"
SVG = HERE / "figures" / f"{NAME}.svg"
CAT = HERE / "controls.yaml"
if NAME.endswith(".svg"):
    SVG = pathlib.Path(NAME).resolve()
    NAME = SVG.stem
    BOXES = SVG.parent / f".{NAME}.boxes.json"
GEOM = SVG.parent / f".{NAME}.geom.json"

# ── the sizes a boxed figure is shown at (rule 9) ────────────────────────────
# Print: measured from the built PDF, not assumed. `bin/build-pdf --paper
# software-factory --draft` on 12 Oct 2026 (A4, 30 mm side margins): in Figure 3,
# "Runtime" (canvas x 282) and "Source" (canvas x 618) start 194.13 pt apart, and
# "Developer" (x 18) to "Source" is 346.67 pt over 600 units — 0.5778 pt a unit
# both ways, so the 736-unit canvas prints 425.24 pt, the 150 mm text column. An
# earlier version of this rule assumed a 6.5 in (468 pt) column and so passed
# text that prints at 6.5 pt.
PRINT_WIDTH_PT, MIN_PT = 425.2, 7.0
# Screen: a 375 px phone less 16 px gutters each side is 343 px, the width every
# narrow variant (and any wide figure without one) is shown at. A wide figure
# with a narrow variant is shown only from 800 px up (reference-architecture's
# `.sff` rules), where its slot is 800 − 2 × 32 = 736 px at its narrowest.
PHONE_PX, WIDE_MIN_PX, MIN_PX = 343, 736, 10.0

if not BOXES.exists():
    sys.exit("no box manifest — run whitepaper/figures/build-figure-1.py first")

boxes = json.loads(BOXES.read_text(encoding="utf-8"))
svg = SVG.read_text(encoding="utf-8")
errors = []

# canvas
vb = re.search(r'viewBox="0 0 (\d+) (\d+)"', svg)
W, H = int(vb.group(1)), int(vb.group(2))

def overlap(a, b):
    return not (a["x"] + a["w"] <= b["x"] + 0.5 or b["x"] + b["w"] <= a["x"] + 0.5
                or a["y"] + a["h"] <= b["y"] + 0.5 or b["y"] + b["h"] <= a["y"] + 0.5)

# 1. text-on-text collisions
for i, a in enumerate(boxes):
    for b in boxes[i + 1:]:
        if overlap(a, b):
            errors.append(
                f"text collision: {a['tag']!r} ({a['x']:.0f},{a['y']:.0f} "
                f"{a['w']:.0f}×{a['h']:.0f}) overlaps {b['tag']!r} "
                f"({b['x']:.0f},{b['y']:.0f} {b['w']:.0f}×{b['h']:.0f})")

# 2. escaping the canvas
for a in boxes:
    if a["x"] < 0 or a["y"] < 0 or a["x"] + a["w"] > W + 0.5 or a["y"] + a["h"] > H + 0.5:
        errors.append(f"text outside canvas: {a['tag']!r} at "
                      f"({a['x']:.0f},{a['y']:.0f}) {a['w']:.0f}×{a['h']:.0f}, canvas {W}×{H}")

# NOTE: containment and cell-in-band checks lived here. They were removed with
# the "no fills, no nested boxes" rewrite, which left them matching nothing while
# still printing a reassuring pass. If boxed elements return, so must they.

# 3c. no horizontal rule may cut through a text run — this is how the closing
#     rule ended up drawn above the last row's glosses.
hrules = [(float(x1), float(y), float(x2)) for x1, y, x2 in
          re.findall(r'<line x1="([\d.]+)" y1="([\d.]+)" x2="([\d.]+)" y2="\2"', svg)]
for a in boxes:
    for rx1, ry, rx2 in hrules:
        if a["y"] + 1 < ry < a["y"] + a["h"] - 1 and rx1 < a["x"] + a["w"] and a["x"] < rx2:
            errors.append(f"a rule crosses text: y={ry:.0f} cuts {a['tag']!r} "
                          f"({a['y']:.0f}..{a['y']+a['h']:.0f})")

# 3d. a gradient stroke on a <line> must use userSpaceOnUse. A horizontal line
#     has a zero-height bounding box, so an objectBoundingBox gradient is
#     undefined and the stroke silently renders as nothing — invisible to every
#     other check here, because the geometry is still perfectly correct.
for _m in re.finditer(r'<line[^>]*stroke="url\(#([^)]+)\)"', svg):
    _gid = _m.group(1)
    _g = re.search(r'<linearGradient id="%s"([^>]*)>' % re.escape(_gid), svg)
    if not _g:
        errors.append(f"stroke references a missing gradient: #{_gid}")
    elif 'gradientUnits="userSpaceOnUse"' not in _g.group(1):
        errors.append(f"gradient #{_gid} strokes a <line> without userSpaceOnUse — "
                      f"a line's bounding box has zero height, so it will not render")

# 3e. arrows must point forward and be long enough to read as arrows. A line
#     whose end is left of its start renders a reversed marker; a 12px one
#     collapses to a triangle. Both are correct geometry and wrong drawings.
for _m in re.finditer(r'<line x1="([\d.]+)" y1="([\d.]+)" x2="([\d.]+)" y2="\2"'
                      r'[^>]*marker-end', svg):
    _x1, _x2 = float(_m.group(1)), float(_m.group(3))
    if _x2 < _x1:
        errors.append(f"arrow points backwards: {_x1:.0f} to {_x2:.0f}")
    elif _x2 - _x1 < 18:
        errors.append(f"arrow is {_x2-_x1:.0f}px — too short to read as an arrow")

# 4. identifier ranges agree with the source of truth
cat = CAT.read_text(encoding="utf-8")
hi = {}
for m in re.finditer(r"^  - id: (\w+)-(\d+)$", cat, re.M):
    hi[m.group(1)] = max(hi.get(m.group(1), 0), int(m.group(2)))
# A figure may legitimately carry no identifiers — they live on /controls/. What
# it may not do is carry one that disagrees with the source of truth.
present = re.findall(r"\b([A-Z]{3})-01…(\d{2})\b", svg)
for fam, shown in present:
    if fam in hi and int(shown) != hi[fam]:
        errors.append(f"{fam}-01…{shown} is stale — controls.yaml has "
                      f"{hi[fam]:02d} as the highest identifier")
if present:
    for fam in hi:
        if fam not in {f for f, _ in present}:
            errors.append(f"{fam} range missing — a figure carries all identifier "
                          f"ranges or none, not some")

# 5–9. boxed figures only: geometry the text manifest cannot see.
if GEOM.exists():
    geom = json.loads(GEOM.read_text(encoding="utf-8"))
    shapes, links = geom["shapes"], geom["links"]
    T = 0.5

    def inside(a, s, tol=T):
        return (a["x"] >= s["x"] - tol and a["y"] >= s["y"] - tol and
                a["x"] + a["w"] <= s["x"] + s["w"] + tol and
                a["y"] + a["h"] <= s["y"] + s["h"] + tol)

    def meets(a, s, inset=0.0):
        return not (a["x"] + a["w"] <= s["x"] + inset or s["x"] + s["w"] - inset <= a["x"] or
                    a["y"] + a["h"] <= s["y"] + inset or s["y"] + s["h"] - inset <= a["y"])

    def seg_hits_rect(p, q, r, inset):
        """Does the axis-parallel segment p→q pass through r shrunk by inset?"""
        x0, y0 = r["x"] + inset, r["y"] + inset
        x1, y1 = r["x"] + r["w"] - inset, r["y"] + r["h"] - inset
        if x1 <= x0 or y1 <= y0:
            return False
        (ax, ay), (bx, by) = p, q
        if ay == by:
            return y0 < ay < y1 and min(ax, bx) < x1 and max(ax, bx) > x0
        if ax == bx:
            return x0 < ax < x1 and min(ay, by) < y1 and max(ay, by) > y0
        return True  # diagonals are not drawn here; flag any that appear

    def segs(l):
        return list(zip(l["pts"], l["pts"][1:]))

    def on_rect_edge(pt, s, tol=1.5):
        x, y = pt
        inx = s["x"] - tol <= x <= s["x"] + s["w"] + tol
        iny = s["y"] - tol <= y <= s["y"] + s["h"] + tol
        return ((inx and (abs(y - s["y"]) <= tol or abs(y - s["y"] - s["h"]) <= tol)) or
                (iny and (abs(x - s["x"]) <= tol or abs(x - s["x"] - s["w"]) <= tol)))

    def on_seg(pt, p, q, tol=1.0):
        (x, y), (ax, ay), (bx, by) = pt, p, q
        return (min(ax, bx) - tol <= x <= max(ax, bx) + tol and
                min(ay, by) - tol <= y <= max(ay, by) + tol and
                (abs(ax - bx) <= tol and abs(x - ax) <= tol or
                 abs(ay - by) <= tol and abs(y - ay) <= tol))

    edged = [s for s in shapes if s["kind"] not in ("glyph", "badge")]
    # 5. text inside a box or clear of it; nothing on a glyph or a badge's disc
    for a in boxes:
        if a["tag"].startswith("#"):          # a badge's numeral sits on its disc
            continue
        for sh in shapes:
            if sh["kind"] in ("glyph", "badge"):
                if meets(a, sh):
                    errors.append(f"text on a mark: {a['tag']!r} touches {sh['tag']!r}")
            elif meets(a, sh) and not inside(a, sh):
                errors.append(f"text straddles a box edge: {a['tag']!r} "
                              f"({a['x']:.0f},{a['y']:.0f} {a['w']:.0f}×{a['h']:.0f}) "
                              f"and {sh['tag']!r} ({sh['x']},{sh['y']} {sh['w']}×{sh['h']})")
    # 6a. no connector through text
    for l in links:
        for p, q in segs(l):
            for a in boxes:
                if seg_hits_rect(p, q, a, 0.5):
                    errors.append(f"connector through text: {l['tag']!r} crosses {a['tag']!r}")
    # 6b. no connector through a card (its own ends touch only the edge)
    for l in links:
        for p, q in segs(l):
            for sh in shapes:
                if sh["solid"] and seg_hits_rect(p, q, sh, 1.5):
                    errors.append(f"connector through a box: {l['tag']!r} crosses {sh['tag']!r}")
    # 6c. connectors don't cross each other, except within one fan-out
    for i, l in enumerate(links):
        for m in links[i + 1:]:
            if l.get("group") and l.get("group") == m.get("group"):
                continue
            for p, q in segs(l):
                for r, t in segs(m):
                    hz1, hz2 = p[1] == q[1], r[1] == t[1]
                    if hz1 == hz2:
                        continue
                    h_, v_ = ((p, q), (r, t)) if hz1 else ((r, t), (p, q))
                    yh, xv = h_[0][1], v_[0][0]
                    if (min(h_[0][0], h_[1][0]) < xv < max(h_[0][0], h_[1][0]) and
                            min(v_[0][1], v_[1][1]) < yh < max(v_[0][1], v_[1][1])):
                        errors.append(f"connectors cross: {l['tag']!r} and {m['tag']!r} "
                                      f"at ({xv:.0f},{yh:.0f})")
    # 7. both ends land on a box edge or on another connector (a legend's
    #    sample stroke is declared free: it stands for a connector, not one)
    for l in links:
        if l.get("free"):
            continue
        for end in (l["pts"][0], l["pts"][-1]):
            ok = any(on_rect_edge(end, sh) for sh in edged)
            ok = ok or any(on_seg(end, p, q) for m in links if m is not l for p, q in segs(m))
            if not ok:
                errors.append(f"connector lands in air: {l['tag']!r} at "
                              f"({end[0]:.0f},{end[1]:.0f})")
    # 8. an arrow's last leg reads as an arrow
    for l in links:
        if l["head"]:
            (ax, ay), (bx, by) = l["pts"][-2], l["pts"][-1]
            leg = abs(bx - ax) + abs(by - ay)
            if leg < 18:
                errors.append(f"arrow {l['tag']!r} ends in a {leg:.0f}px leg — "
                              f"too short to read as an arrow")
    # 9. legible at every size it is shown — decided here, never by the
    #    figure's own manifest, so no figure can opt out by omission
    narrow = NAME.endswith("-narrow")
    has_narrow = (SVG.parent / f"{NAME}-narrow.svg").exists()
    shown = []
    if not narrow:
        shown.append(("in print", PRINT_WIDTH_PT / W, MIN_PT, "pt",
                      f"across the PDF's {PRINT_WIDTH_PT} pt figure width"))
    if narrow or not has_narrow:
        shown.append(("on a phone", PHONE_PX / W, MIN_PX, "px",
                      f"across a {PHONE_PX} px phone column"
                      + ("" if narrow else " (this figure has no narrow variant)")))
    else:
        shown.append(("on the page", WIDE_MIN_PX / W, MIN_PX, "px",
                      f"in the page's narrowest wide slot, {WIDE_MIN_PX} px"))
    for where, k, least, unit, at in shown:
        worst = min(boxes, key=lambda a: a["h"])
        size = worst["h"] / 1.02 * k
        if size < least - 0.005:
            small = [a["tag"] for a in boxes if a["h"] / 1.02 * k < least - 0.005]
            errors.append(f"text too small {where}: {len(small)} run(s), smallest "
                          f"{worst['tag']!r} at {size:.2f} {unit} {at} (min {least:g} {unit}); "
                          f"e.g. {', '.join(map(repr, small[:4]))}")
    for sh in shapes:
        if sh["x"] < -T or sh["y"] < -T or sh["x"] + sh["w"] > W + T or sh["y"] + sh["h"] > H + T:
            errors.append(f"box outside canvas: {sh['tag']!r}")
    # 10. a margin of air on every side
    EDGE = 6
    def near_edge(x0, y0, x1, y1):
        return x0 < EDGE - T or y0 < EDGE - T or x1 > W - EDGE + T or y1 > H - EDGE + T
    for sh in shapes:
        if near_edge(sh["x"], sh["y"], sh["x"] + sh["w"], sh["y"] + sh["h"]):
            errors.append(f"box touches the canvas edge: {sh['tag']!r} "
                          f"({sh['x']:.0f},{sh['y']:.0f} {sh['w']:.0f}×{sh['h']:.0f}) — "
                          f"keep {EDGE} units clear")
    for a in boxes:
        if near_edge(a["x"], a["y"], a["x"] + a["w"], a["y"] + a["h"]):
            errors.append(f"text touches the canvas edge: {a['tag']!r}")
    for l in links:
        for x, y in l["pts"]:
            if near_edge(x, y, x, y):
                errors.append(f"connector touches the canvas edge: {l['tag']!r} at "
                              f"({x:.0f},{y:.0f})")
                break

print(f"{NAME}: {W}×{H} · {len(boxes)} text runs")
for e in errors:
    print(f"  ERROR  {e}")
print(f"\n{len(errors)} error(s)")
sys.exit(1 if errors else 0)
