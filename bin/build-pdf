  font-size:9pt; color:var(--ink); }
table.t-outcomes th:nth-child(1) { width:20%; }
/* Balanced lines suit a narrow cell; in these wide ones they stopped every
   line well short of the column, so it read as narrower than it is. */
table.t-outcomes td + td, table.t-controls td + td { text-wrap:pretty; }
table.t-outcomes a.oc { color:inherit; }
table.t-controls th:nth-child(1) { width:27%; }

/* How the factory deepens across levels: one block per row, the component as
   its head and each level beneath with its name in the margin. Set as the
   four-column table it is in the source, three paragraphs were squeezed to a
   few words a line, and a row that broke across a page left a level's text
   with no component above it — the Appendix A failure. A block never splits. */
.deepen { margin:4mm 0 2mm; }
/* The key: the table's own head, once. Label voice like a th, then each
