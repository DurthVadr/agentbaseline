dl.glossary dd { margin:0; font-size:9pt; line-height:1.5; color:var(--soft);
  text-align:left; }
"""

# A draft says so on every page, in the centre of the foot, which neither
# paper uses, and on its cover. Appended only for --draft, so a publishable
# build's stylesheet does not contain it at all.
DRAFT_CSS = """
@page { @bottom-center { content: "Draft · not for publication"; font-family:"IBM Plex Mono",monospace;
  font-size:7.5pt; font-weight:600; letter-spacing:.06em; color:#B3541E; } }
@page cover { @bottom-center { content:none } }
.cover .draft { position:absolute; top:22mm; right:30mm; margin:0;
  font-family:"IBM Plex Mono",monospace; font-size:8pt; font-weight:600;
  letter-spacing:.06em; color:#B3541E; }
"""


PUBLISHED_RE = r"Published as\b[^\n]*?·\s*(\d{1,2}\s+[A-Za-z]+\s+\d{4})"
COMMENTS_RE = r"Draft for public comment until\s+(\d{1,2}\s+[A-Za-z]+\s+\d{4})"


def front_matter_dates(src):
    """The paper's published date and comment deadline, from its own front matter.

    One reading, used for both the cover and the PDF's timestamps. The cover used
    to carry its own hardcoded copy of both dates while only the timestamps were
    parsed from here, so moving the paper's date produced a PDF whose Document
    Properties said 14 August and whose cover, printed by this same function, said
    30 July. Nothing compared them because nothing could: they were two constants
    that happened to agree. Derived from one string they cannot disagree, which is
    a stronger guarantee than a check that they do.

    hugo.toml states both dates a third time, for the site. That copy cannot be
    removed — the templates need it and the paper is not a Hugo page — so
    check-copy compares it against this front matter instead.

    Reading the date from the source rather than the clock is also what makes the
    build reproducible: SOURCE_DATE_EPOCH derives from it, so the same source
    always yields the same bytes.

    This raises rather than falling back. The previous version stamped 1 January
    2026 and warned, on the reasoning that a wrong date still builds reproducibly
    and breaking a build over metadata is worse. That reasoning held while the
    date was only in the Document Properties. It does not hold now the cover is
    printed from the same value: a conference handout whose cover reads "published
    1 January 2026" is worse than a build that stops and says which line it could
    not read. Abbreviating the month is enough to land here.
    """
    text = src.read_text(encoding="utf-8")
    found = {}
    for key, pattern, shape in (
        ("published", PUBLISHED_RE, "Published as **Agent Baseline** · v… · 30 July 2026 · …"),
        ("comments", COMMENTS_RE, "Draft for public comment until 30 September 2026."),
    ):
        m = re.search(pattern, text)
        if not m:
            sys.exit(f"cannot read the {key} date from whitepaper.md's front matter.\n"
                     f"  expected a line shaped like: {shape}\n"
                     f"The cover and the PDF's timestamps are both printed from that line, "
                     f"so there is nothing sensible to fall back to. Fix the front matter, "
                     f"or update {pathlib.Path(__file__).name} if the wording moved on purpose.")
        try:
            datetime.datetime.strptime(m.group(1), "%d %B %Y")
        except ValueError:
            sys.exit(f"whitepaper.md's {key} date is not a date this can parse: "
                     f"{m.group(1)!r} — write it as '30 July 2026', month unabbreviated.")
        found[key] = m.group(1)
    return found


def published_epoch(published, fmt="%d %B %Y"):
    """The published date as a UTC epoch, for /CreationDate and /ModDate."""
    d = datetime.datetime.strptime(published, fmt)
    # Midday rather than midnight: the stored value is UTC but readers see it in
    # local time, and a midnight stamp displays as the previous day anywhere west
    # of Greenwich — a PDF of the 30th reporting the 29th looks like a bug in the
    # date. Noon survives every offset.
    return calendar.timegm(d.timetuple()) + 12 * 3600


# ── the white paper ──────────────────────────────────────────────────────────
def build_whitepaper(paper, draft):
    """The white paper's document, exactly as this script has always assembled it."""
    src = paper["src"]
    OUTCOMES, CONTROLS = load_controls()

    md = record(src).read_text(encoding="utf-8")

    # The paper's hand-written contents is a flat list of links. It is useful on
    # GitHub and useless in print, where a link with no page number cannot be
    # followed. Dropped here and rebuilt below with real page references.
    md, _ = cut_section(md, r"^# Contents\b.*$")
    # Appendix A is regenerated from controls.yaml.
    md, _ = cut_section(md, r"^# Appendix A\b.*$")

    body = pandoc(md, paper["work"])

    # The paper opens with a title, a subtitle and two published lines. All four
    # are the cover's job. Left in the flow they do not simply repeat the cover —
    # they land orphaned at the foot of the contents page, under the leaders.
    body = re.sub(r"^\s*<h1[^>]*>.*?</h1>", "", body, count=1, flags=re.S)
    for _ in range(2):
        body = re.sub(r"^\s*<p>(?:(?!</p>).)*?(?:Identify the agent|Published as).*?</p>",
                      "", body, count=1, flags=re.S)

    body, _ = figures(body, src, draft)

    # ── contents, with page numbers resolved by Paged.js ─────────────────────
    toc = contents(body)
    toc.append(("1", "appendix-a", "Appendix A. Canonical capability map"))
    toc_html = contents_html(toc)

    # ── the appendix, as blocks rather than a table ──────────────────────────
    by_outcome = {}
    for c in CONTROLS:
        by_outcome.setdefault(c["outcome"], []).append(c)
    app = []
    for o in OUTCOMES:
        rows = by_outcome.get(o["prefix"], [])
        if not rows:
            continue
        ids = f'{rows[0]["id"]}–{rows[-1]["id"]}'
        app.append(f'<section class="fam">'
                   f'<h2 id="app-{o["prefix"].lower()}">{html.escape(o["name"])}'
                   f'<span class="span">{ids}</span></h2>'
                   f'<p class="famreq">{html.escape(o["requirement"] or "")}</p>')
        for c in rows:
            app.append(
                f'<div class="ctl" id="{c["id"]}">'
                f'<div class="cid">{c["id"]}</div>'
                f'<div class="cbody"><div class="chead">'
                f'<span class="ctitle">{html.escape(c["title"] or "")}</span>'
                f'<span class="ctype">{html.escape(c["type"] or "")}</span></div>'
                f'<p class="creq">{html.escape(c["requirement"] or "")}</p></div></div>')
        app.append("</section>")
    appendix_html = "\n".join(app)

    FONTS = fonts()

    dates = front_matter_dates(src)
    version = "1.0-draft"
    m = re.search(r'^version:\s*"([^"]+)"',
                  (ROOT / "whitepaper" / "controls.yaml").read_text(encoding="utf-8"), re.M)
    if m:
        version = m.group(1)
    # str.replace, not %-formatting: the stylesheet is full of
    # percentages and every one of them is a format specifier.
    css = CSS.replace("@VERSION@", version)
    if draft:
        css += DRAFT_CSS

    authors = ""
    cpath = ROOT / "whitepaper" / "contributors.yaml"
    if cpath.exists():
        people = []
        for blk in re.split(r"\n(?=  - )", record(cpath).read_text(encoding="utf-8")):
            if not blk.lstrip().startswith("- name:"):
                continue
            def f(k):
                m = re.search(rf"^[ \t-]*{k}:[ \t]*(.+)$", blk, re.M)
                return m.group(1).strip().strip('"') if m else ""
            # confirmed: false means the affiliation has not been agreed by the
            # person. contributors.yaml is explicit that those must not be
            # published, and a cover is the most published place there is.
            if f("confirmed").lower() == "true" and f("name"):
                people.append((f("sortkey") or f("name"), f("name"), f("affiliation")))
        people.sort()
        if people:
            names = [f'{n}<sup>{a}</sup>' if a else n for _, n, a in people]
            joined = (", ".join(names[:-1]) + " and " + names[-1]
                      if len(names) > 1 else names[0])
            authors = "Drafted by " + joined + "."

    doc = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>Agent Baseline — six security outcomes for enterprise AI agents</title>
<style>{FONTS}</style>
<style>{css}</style>
</head><body>

<section class="cover">
  <p class="mark">Agent Baseline · agentbaseline.org</p>{'''
  <p class="draft">Draft · not for publication</p>''' if draft else ''}
  <h1 class="covertitle">Six security outcomes for safely building, deploying and operating AI agents</h1>
  <ul class="tenets">
    <li>Identify the agent.</li><li>Bound its authority.</li>
    <li>Control its actions.</li><li>Prove its outcomes.</li>
  </ul>
  <p class="by">{authors}</p>
  <p class="meta">
    <b>v{version}</b> · published {dates["published"]}<br>
    Draft for public comment until {dates["comments"]}<br>
    {len(CONTROLS)} controls across {len(OUTCOMES)} outcomes<br>
    Prose and figures CC BY 4.0 · schemas Apache-2.0
  </p>
</section>

<nav class="toc"><h2>Contents</h2><ol>{toc_html}</ol></nav>

{body}

<section class="appendix">
  <h1 id="appendix-a">Appendix A. Canonical capability map</h1>
  <p>This catalogue is generated from <code>whitepaper/controls.yaml</code>, which is
  the source of truth for the baseline. Capabilities are grouped by their primary
  required outcome.</p>
  {appendix_html}
</section>

<script>window.PagedConfig = {{ auto: false }};</script>
<script src="{PAGED.as_uri()}"></script>
</body></html>"""

    # The scripts are inputs too: the stylesheet and the cover live in this file,
    # the normalisation lives in print-page.mjs, and the catalogue reader in
    # controls_source.py decides what the appendix says. A change to any of them
    # changes the artifact, so a manifest that omitted them would call a stale PDF
    # current.
    record(ROOT / "bin" / "controls_source.py")
    return {
        "doc": doc,
        "epoch": published_epoch(dates["published"]),
        "print_args": [],
        "summary": f"{len(CONTROLS)} controls · {len(toc)} contents entries",
    }


# ── the reference architecture ───────────────────────────────────────────────
# "Version 1, October 13, 2026": the version, then the date with the month in
# full. The white paper writes its date the other way round, in a different
# sentence, so each paper is read in its own shape rather than one regex being
# loosened until it accepts both.
SF_VERSION_RE = r"^Version\s+(\S+?),\s+([A-Za-z]+\s+\d{1,2},\s+\d{4})\s*$"
SF_BYLINE_RE = r"^Drafted by\s+(.+?)\.?\s*$"


def sf_front_matter(md, src):
    """Title, version, date and byline, from the paper's own first lines.

    Fails rather than guessing, for the reason front_matter_dates() gives: the
    cover, the running foot and the PDF's timestamps are all printed from these,
    and a cover with an invented date is worse than a build that stops.
    """
    name = rel(src)
    t = re.match(r"\s*#\s+(.+?)\s*\n", md)
    if not t:
        sys.exit(f"{name} does not open with a `# Title` line; the cover is printed from it.")
    v = re.search(SF_VERSION_RE, md, re.M)
    if not v:
        sys.exit(f"cannot read the version and date from {name}'s front matter.\n"
                 f"  expected a line shaped like: Version 1, October 13, 2026\n"
                 f"The cover, the running foot and the PDF's timestamps are all printed "
                 f"from that line, so there is nothing sensible to fall back to. Fix the "
                 f"front matter, or update {pathlib.Path(__file__).name} if the wording "
                 f"moved on purpose.")
    try:
        when = datetime.datetime.strptime(" ".join(v.group(2).split()), "%B %d, %Y")
    except ValueError:
        sys.exit(f"{name}'s date is not a date this can parse: {v.group(2)!r} — write it "
                 f"as 'October 13, 2026', month unabbreviated.")
    b = re.search(SF_BYLINE_RE, md, re.M)
    if not b:
        sys.exit(f"cannot read the byline from {name}'s front matter.\n"
                 f"  expected a line shaped like: Drafted by A Person (Org), … and B Person (Org).\n"
                 f"The cover credits the authors from that line and the PDF's Author "
                 f"field lists them; neither should be left blank by accident.")
    people = []
    # Commas and "and" inside an affiliation's parentheses are not separators.
    for seg in re.split(r",\s+(?:and\s+)?(?![^()]*\))|\s+and\s+(?![^()]*\))", b.group(1)):
        seg = seg.strip()
        if not seg:
            continue
        m = re.fullmatch(r"(.+?)\s*\(([^()]+)\)", seg)
        people.append((m.group(1), m.group(2)) if m else (seg, ""))
    if not people:
        sys.exit(f"{name}'s byline names nobody: {b.group(0)!r}")
    return {"title": t.group(1), "version": v.group(1), "date": when,
            "date_line": v.group(0).strip(), "byline": b.group(0).strip(),
            "people": people}


def sf_contributors(people):
    """Refuse a byline that names anyone contributors.yaml has not confirmed.

    The byline is printed from the paper's own first lines, on the cover and in
    /Author. contributors.yaml is where a person's consent to be listed, and
    their affiliation, is recorded: the site's page prints only `confirmed: true`
    entries, and the white paper's cover does the same. Read from the paper
    alone, a withdrawn name stayed on the PDF's cover after it had left the site,
    and the PDF was not even stale, because the yaml was not an input. It is
    recorded now, and every byline name must be in it, confirmed, with the same
    affiliation, or the build stops and says who.

    The file holds one entry per line, `- { name: …, affiliation: …, … }`, or the
    white paper's block form; both are read.
    """
    path = ROOT / "software-factory" / "contributors.yaml"
    if not path.exists():
        sys.exit(f"{rel(path)} is missing; the byline cannot be checked against it.")
    text = record(path).read_text(encoding="utf-8")
    body = text.split("contributors:", 1)[1] if "contributors:" in text else ""
    entries = []
    for blk in re.split(r"\n(?=\s*- )", body):
        blk = blk.strip()
        if not blk.startswith("-"):
            continue
        flow = re.fullmatch(r"-\s*\{(.*)\}\s*(?:#.*)?", blk, re.S)
        pairs = (re.findall(r"(\w+)\s*:\s*([^,]+?)\s*(?:,|$)", flow.group(1)) if flow else
                 re.findall(r"^[ \t-]*(\w+):[ \t]*(.+?)[ \t]*$", blk, re.M))
        entries.append({k: v.strip().strip('"\'') for k, v in pairs})
    known = {e.get("name"): e for e in entries if e.get("name")}
    wrong = []
    for name, aff in people:
        e = known.get(name)
        if e is None:
            wrong.append(f"{name}: not in {rel(path)}")
        elif e.get("confirmed", "").lower() != "true":
            wrong.append(f"{name}: confirmed is {e.get('confirmed') or 'missing'}, not true")
        elif e.get("affiliation", "") != aff:
            wrong.append(f"{name}: the byline says {aff!r}, {rel(path)} says {e.get('affiliation')!r}")
    if wrong:
        sys.exit("the byline names people contributors.yaml does not confirm as printed:\n" +
                 "".join(f"    {w}\n" for w in wrong) +
                 "The cover and /Author print the byline, and nothing is published unconfirmed. "
                 "Fix the paper's byline or the yaml, whichever is wrong.")


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def cells(row, tag):
    return [c.strip() for c in re.findall(rf"<{tag}\b[^>]*>(.*?)</{tag}>", row, re.S)]


def sf_tables(body):
    """Give each table its own treatment, keyed on its first column's heading.

    Keyed on the heading rather than on position, so a table added above another
    does not inherit its neighbour's layout. pandoc's colgroup gives every column
    an equal share, which no table here wants; it goes, and the widths are set by
    class in SF_CSS.
    """
    kinds = {"What": "t-threat", "Level": "t-levels", "Outcome": "t-outcomes",
             "Autonomy level": "t-controls", "Boundary or component": "deepen"}
    seen = []

    def one(m):
        t = re.sub(r"<colgroup>.*?</colgroup>\s*", "", m.group(0), flags=re.S)
        head = cells(re.search(r"<thead>(.*?)</thead>", t, re.S).group(1), "th")
        kind = kinds.get(re.sub(r"<[^>]+>", "", head[0]).strip())
        seen.append(kind)
        if kind == "deepen":
            return deepen(t, head)
        if kind == "t-outcomes":
            # Each outcome names the section of the controls page that defines it,
            # anchored there by its name in lower case, as on the site's own pages.
            # Only in the PDF: the paper's source and the site page are untouched.
            t = re.sub(r"(<tr\b[^>]*>\s*<td\b[^>]*>)\s*(Discover|Constrain|Authorize|Observe|Validate|Respond)\s*(</td>)",
                       lambda c: f'{c.group(1)}<a class="oc" href="https://agentbaseline.org/controls#'
                                 f'{c.group(2).lower()}">{c.group(2)}</a>{c.group(3)}', t)
        if kind == "t-threat":
            t = re.sub(r"(<td\b[^>]*>)\s*(Untrusted|Trusted)\s*(</td>)",
                       lambda c: f'{c.group(1)}<span class="trust {c.group(2).lower()}">'
                                 f'{c.group(2)}</span>{c.group(3)}', t)
        return t.replace("<table>", f'<table class="{kind}">', 1) if kind else t

    body = re.sub(r"<table>.*?</table>", one, body, flags=re.S)
    if "deepen" not in seen and 'id="how-the-factory-deepens-across-levels"' in body:
        sys.exit("found the heading 'How the factory deepens across levels' but not its "
                 "table (first column 'Boundary or component'). Set as a plain table it "
                 "squeezes three paragraphs into quarter-width columns and splits rows "
                 "across pages; fix the table, or update sf_tables().")
    return body


def deepen(table, head):
    """The four-column levels table as one unsplittable block per row.

    The table's head is set once, as a key above the blocks: what the first
    column holds and each level's full name. Repeated in every block, the
    names took three lines of the margin beside a one-line description, so the
    level, not what it said, set the height of nearly every entry; and the
    first column's heading was not printed at all."""
    if len(head) != 4:
        sys.exit(f"'How the factory deepens across levels' has {len(head)} columns, not 4 "
                 f"(a component and three levels); update deepen() to match.")
    levels = []
    for h in head[1:]:
        text = html.unescape(re.sub(r"<[^>]+>", "", h)).strip()
        lead, _, rest = text.partition(":")
        levels.append((html.escape(lead.strip()), html.escape(" ".join(rest.split()))))
    rows = re.findall(r"<tr\b[^>]*>(.*?)</tr>", re.search(r"<tbody>(.*?)</tbody>", table, re.S).group(1), re.S)
    first = html.escape(html.unescape(re.sub(r"<[^>]+>", "", head[0])).strip())
    out = ['<div class="deepen">', f'<dl class="key"><div class="k0">{first}</div>']
    out += [f'<div class="lv"><dt>{lead}</dt><dd>{rest}</dd></div>' for lead, rest in levels]
    out.append("</dl>")
    # The key is a table head: it never ends a page without the first entry.
    out.insert(1, '<div class="keep">')
    for n, r in enumerate(rows):
        c = cells(r, "td")
        if len(c) != 4:
            sys.exit(f"a row of 'How the factory deepens across levels' has {len(c)} cells: {c[:1]}")
        out.append(f'<div class="row"><p class="comp">{c[0]}</p><dl>')
        for (lead, rest), text in zip(levels, c[1:]):
            out.append(f'<div class="lv"><dt>{lead}</dt><dd>{text}</dd></div>')
        out.append("</dl></div>" + ("</div>" if n == 0 else ""))
    out.append("</div>")
    return "\n".join(out)


def sf_inline_figures(body):
    """Set each SVG figure into the page itself rather than behind an <img>.

    An SVG loaded as an image is a document of its own and cannot see the page's
    @font-face rules, so the figures' Figtree, Plex and Chakra Petch fell back to
    whatever the building machine had: pdffonts listed Avenir Next, Charter and
    Menlo, the figures printed in faces the site does not use, and they printed
    in different ones on a different machine. Set inline, a figure takes the
    embedded faces like the text around it and shares their subsets. The site
    inlines the same files (bin/sync-figure-partial), and every id in them is
    already prefixed per figure (sf3-a), so two figures cannot collide.

    The paper's alt text, which figures() has already refused if it is missing
    or a TODO, becomes the drawing's accessible name. The files are recorded
    here because the file:// sweep in render() no longer sees them.
    """
    def one(m):
        tag = m.group(0)
        url = re.search(r'\bsrc="(file://[^"]*)"', tag).group(1)
        alt = re.search(r'\balt="([^"]*)"', tag)
        svg = record(pathlib.Path(urllib.request.url2pathname(url[len("file://"):]))) \
            .read_text(encoding="utf-8")
        svg = re.sub(r"^\s*<\?xml[^>]*\?>\s*", "", svg)

        def root(r):
            attrs = re.sub(r'\s(?:width|height|role|aria-labelledby|aria-label)="[^"]*"', "", r.group(1))
            return f'<svg{attrs} role="img" aria-label="{alt.group(1) if alt else ""}">'
        return re.sub(r"<svg\b([^>]*)>", root, svg, count=1)
    return re.sub(r'<img\b[^>]*\bsrc="file://[^"]*\.svg"[^>]*>', one, body)


def sf_incidents(body):
    """Each recent incident's date in its own voice, after its name.

    The heads read "PocketOS, April 2026", all in the label voice, so a name and
    a date ran together in one string of capitals. The text is unchanged; what
    follows the first comma that leads to a year is set as a datum, as dates
    are on the cover and in the foot. A head without a date is left whole.
    """
    m = re.search(r'<h2 id="recent-incidents"[^>]*>.*?</h2>(.*?)(?=<h[12][\s>]|\Z)', body, re.S)
    if not m:
        return body

    def dated(x):
        opening = x.group(1).replace("<h3", '<h3 class="incident"', 1)
        return (f'{opening}{x.group(2)}, <span class="when">{x.group(3)}</span>'
                f'{x.group(4) or ""}{x.group(5)}')

    def head(h):
        return re.sub(r"(<h3\b[^>]*>(?:<a\b[^>]*>)?)([^<]*?),\s+([^<,]*\d{4}[^<]*)(</a>)?(</h3>)",
                      dated, h.group(0))
    section = re.sub(r"<h3\b.*?</h3>", head, m.group(1), flags=re.S)
    # A head without a date is still an incident, and takes the incidents'
    # spacing; left out, it sat further below its paragraph than the others.
    section = re.sub(r"<h3(?![^>]*\bclass=)", '<h3 class="incident"', section)
    return body[:m.start(1)] + section + body[m.end(1):]


def sf_keep_lists(body):
    """A label head over a list keeps its first two items with it.

    break-after:avoid on the head binds it to the list's first item only, so a
    head could close a page with one requirement under it and the rest overleaf.
    A keep rule on the items themselves is what CSS offers, and Paged.js does not
    honour it: on the appendix lists it pushed whole sections to the next page
    and left a head at a foot with nothing under it. So the head and the first
    two items are set as one unbreakable group, and the list continues in a
    second <ul> with no space between, which reads as the same list.
    """
    def one(m):
        items = re.findall(r"<li>.*?</li>", m.group(2), re.S)
        if len(items) < 3 or any("<ul" in i or "<ol" in i for i in items):
            return m.group(0)
        return (f'<div class="keep">{m.group(1)}<ul class="lead">{"".join(items[:2])}</ul></div>'
                f'<ul class="cont">{"".join(items[2:])}</ul>')
    body = re.sub(r"(<h3\b[^>]*>(?:(?!</h3>).)*</h3>)\s*<ul>\s*((?:(?!</ul>).)*?)\s*</ul>",
                  one, body, flags=re.S)
    # A section head directly over a label head is one unit too. Paged.js keeps
    # a head with the block after it, but not a chain of two: "Implementation
    # reference" was left alone at the foot of a page with its first label head
    # and paragraph overleaf.
    return re.sub(r"(<h2\b[^>]*>(?:(?!</h2>).)*</h2>)\s*(<h3\b[^>]*>(?:(?!</h3>).)*</h3>)",
                  r'<div class="keep">\1\2</div>', body, flags=re.S)


def sf_glossary(body):
    """The Definitions section as a glossary, and every bolded term linked to it.

    Every paragraph in the section must be a `**Term:** text` definition. A
    paragraph of another shape would otherwise be dropped from a list it does not
    belong in, or silently left as the one plain paragraph among the entries.
    """
    # The section runs to the next h1 or h2, or to the end of the document: as
    # the last section it used to match nothing, and the glossary, its links and
    # the refusal below were all skipped without a word.
    m = re.search(r'(<h2 id="definitions"[^>]*>.*?</h2>)(.*?)(?=<h[12][\s>]|\Z)', body, re.S)
    if not m:
        if 'id="definitions"' in body:
            sys.exit("found the Definitions heading but could not read its section; "
                     "update sf_glossary() rather than print it as plain paragraphs.")
        return body, {}
    entries, terms = [], {}
    rest = m.group(2)
    for p in re.finditer(r"<p><strong>(.+?):</strong>\s*(.*?)</p>", rest, re.S):
        term = " ".join(p.group(1).split())
        anchor = "def-" + slug(html.unescape(term))
        terms[html.unescape(term).lower()] = anchor
        entries.append(f'<div class="entry" id="{anchor}"><dt>{term}</dt>'
                       f'<dd>{p.group(2).strip()}</dd></div>')
    leftover = re.sub(r"<p><strong>.+?:</strong>.*?</p>", "", rest, flags=re.S).strip()
    if leftover or not entries:
        sys.exit("the Definitions section holds something other than `**Term:** text` "
                 f"paragraphs:\n    {leftover[:160]!r}\nSet it by hand or update sf_glossary().")
    gloss = '<dl class="glossary">\n' + "\n".join(entries) + "\n</dl>\n"
    body = body[:m.start(2)] + "\n" + gloss + body[m.end(2):]

    # The paper says bolded terms are defined in the appendix; in a PDF that is
    # a promise a link can keep. Matched case-insensitively and allowing a plural
    # ("blueprints" for Blueprint). The glossary itself is not touched — a term
    # does not link to itself.
    g0 = body.index('<dl class="glossary">')
    g1 = body.index("</dl>", g0)
    unmatched = []

    def link(s):
        # Normalised as the glossary keys are: pandoc wraps a long line inside
        # a bolded term ("agent\nharness"), which matched nothing.
        word = " ".join(html.unescape(re.sub(r"<[^>]+>", "", s.group(1))).split()).lower()
        for k in (word, word[:-1] if word.endswith("s") else None):
            if k and k in terms:
                return f'<a class="term" href="#{terms[k]}">{s.group(0)}</a>'
        if not re.match(r"invariants?:?$", word):
            unmatched.append(word)
        return s.group(0)

    head = re.sub(r"<strong>(.*?)</strong>", link, body[:g0], flags=re.S)
    body = head + body[g0:g1] + body[g1:]
    if unmatched:
        print(f"  note: bolded but not defined: {', '.join(sorted(set(unmatched)))}")
    return body, terms


def build_software_factory(paper, draft):
    src = paper["src"]
    md = record(src).read_text(encoding="utf-8")
    fm = sf_front_matter(md, src)
    sf_contributors(fm["people"])
    body = pandoc(md, paper["work"])

    # The title, the version line and the byline are the cover's. Each must be
    # found and removed exactly once, or the contents page opens with an orphaned
    # copy of the cover, which is what the white paper's version of this did.
    for what, pat in (("title", r"^\s*<h1[^>]*>.*?</h1>"),
                      ("version line", r"^\s*<p>Version\s.*?</p>"),
                      ("byline", r"^\s*<p>Drafted by\s.*?</p>")):
        body, n = re.subn(pat, "", body, count=1, flags=re.S)
        if n != 1:
            sys.exit(f"could not lift the {what} out of the body; the cover would repeat "
                     f"it in the flow. Check the front matter of {rel(src)}.")

    body, figs = figures(body, src, draft)
    body = sf_inline_figures(body)
    body = sf_tables(body)
    body, _ = sf_glossary(body)
    body = sf_keep_lists(body)
    body = sf_incidents(body)
    body = re.sub(r"<p><strong>(Invariants?):</strong>",
                  r'<p class="invariant"><strong>\1:</strong>', body)

    toc = contents(body)
    toc_html = contents_html(toc)
    FONTS = fonts()

    date = f"{fm['date'].day} {fm['date']:%B %Y}"
    running = fm["title"].partition(": ")[0].replace("\\", "\\\\").replace('"', '\\"')
    css = (SF_PAGE_CSS + SHARED_CSS + SF_CSS).replace("@VERSION@", fm["version"]) \
                                             .replace("@DATE@", date) \
                                             .replace("@TITLE@", running)
    if draft:
        css += DRAFT_CSS

    title = fm["title"]
    lead, colon, sub = title.partition(": ")
    # Chrome names the first bookmark from the laid-out text, where an ordinary
    # space before the break collapses and the title came out as
    # "Factory:A Reference Architecture". A no-break space survives layout and
    # is invisible at the end of the line.
    title_html = (f'{html.escape(lead)}:&nbsp;<br><span class="sub">{html.escape(sub)}</span>'
                  if colon else html.escape(title))
    # Each name with its affiliation is one unbreakable run: the byline wraps
    # between people, never between a given name and a family name.
    names = [f'<span class="nb">{html.escape(n)}<sup>{html.escape(a)}</sup></span>' if a
             else f'<span class="nb">{html.escape(n)}</span>'
             for n, a in fm["people"]]
    # The last name is joined as the paper joins it. Its byline has a serial
    # comma ("…Nassri (Socket), and Aaron Stanley…"); the cover used
    # the white paper's plain " and " and dropped it, so the cover did not
    # print what the paper says.
    serial = re.search(r",\s+and\s+[^,]+$", fm["byline"]) is not None
    last = (", and " if serial and len(names) > 2 else " and ")
    byline = ("Drafted by " + (", ".join(names[:-1]) + last + names[-1]
                               if len(names) > 1 else names[0]) + ".")

    doc = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>{html.escape(title)}</title>
<style>{FONTS}</style>
<style>{css}</style>
</head><body>

<section class="cover">
  <p class="mark"><span class="parent">Agent Baseline</span>, applied to the software factory</p>{'''
  <p class="draft">Draft · not for publication</p>''' if draft else ''}
  <h1 class="covertitle">{title_html}</h1>
  <dl class="tb">
    <div class="cell"><dt>Builds on</dt><dd>Agent Baseline</dd></div>
    <div class="cell sep"><dt>Subject</dt><dd>The software factory</dd></div>
    <div class="cell sep"><dt>Version</dt><dd>{html.escape(fm["version"])}</dd></div>
    <div class="cell sep"><dt>Published</dt><dd>{date}</dd></div>
  </dl>
  <p class="by">{byline}</p>
  <p class="meta">
    Open for comment at agentbaseline.org<br>
    Prose and figures CC BY 4.0
  </p>
</section>

<nav class="toc"><h2>Contents</h2><ol>{toc_html}</ol></nav>

{body}

<script>window.PagedConfig = {{ auto: false }};</script>
<script src="{PAGED.as_uri()}"></script>
</body></html>"""

    return {
        "doc": doc,
        "epoch": calendar.timegm(fm["date"].timetuple()) + 12 * 3600,
        # The white paper prints with neither, and must keep printing the same
        # bytes, so these are asked for here rather than made the default.
        "print_args": ["--outline",
                       "--meta", f"Author={', '.join(n for n, _ in fm['people'])}",
                       "--meta", "Subject=Agent Baseline, applied to the software factory",
                       "--meta", "Keywords=Agent Baseline; software factory; reference architecture; "
                                 "AI agents; agent security"],
        "summary": f"{len(figs)} figures · {len(toc)} contents entries"
                   + (" · DRAFT" if draft else ""),
    }


BUILDERS = {"whitepaper": build_whitepaper, "software-factory": build_software_factory}


def render(name, out, provenance, draft=False):
    paper = PAPERS[name]
    built = BUILDERS[name](paper, draft)
    doc = built["doc"]

    page = paper["work"] / "paper.html"
    page.write_text(doc, encoding="utf-8")

    # Everything the document pulls in from disk at print time. The figures are
    # rewritten to absolute file URLs above and Paged.js is loaded from one, so
    # sweeping the rendered document finds them without a second list to keep in
    # step — including the ones a future template adds. Anything outside the repo
    # is somebody's local path and cannot be a recorded input.
    for url in set(re.findall(r'file://[^"\'\s>)]+', doc)):
        p = pathlib.Path(urllib.request.url2pathname(url[len("file://"):]))
        if p.exists() and ROOT in p.resolve().parents:
            record(p)
    # The scripts are inputs too: the stylesheet and the cover live in this file,
    # the normalisation lives in print-page.mjs, and papers.py says which source
    # makes which artifact. A change to any of them changes the artifact, so a
    # manifest that omitted them would call a stale PDF current.
    for script in (pathlib.Path(__file__), ROOT / "bin" / "print-page.mjs",
                   ROOT / "bin" / "papers.py"):
        record(script)

    out.parent.mkdir(parents=True, exist_ok=True)
    # Rendered to a sibling and moved into place, never written through. The old
    # version unlinked the destination and then spent several seconds in Chrome;
    # anything that killed the process in that window — Ctrl-C, a CI timeout, the
    # OOM killer — left the tree with no whitepaper.pdf at all, and the only copy
    # of it in a temporary directory that died with the process. os.replace is
    # atomic within a filesystem, and the temporary file is a sibling so that it
    # is the same filesystem.
    tmp = out.with_name(f".{out.name}.new-{os.getpid()}")
    # A kill that skips the cleanup below leaves one of these; sweep them rather
    # than accumulating megabyte files in static/ until someone notices. The pid
    # in the name is what makes that safe: a leftover whose process is still alive
    # is a build in flight, and deleting it would be this script causing the exact
    # failure it is here to prevent.
    for stale in out.parent.glob(f".{out.name}.new-*"):
        try:
            pid = int(stale.name.rsplit("-", 1)[-1])
        except ValueError:
            continue
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            stale.unlink(missing_ok=True)
        except PermissionError:
            pass  # alive, and not ours
    # The PDF is committed, so it must be reproducible: two builds of unchanged
    # source have to produce the same bytes, or `git diff` reports the artifact as
    # modified on every rebuild and a reviewer cannot tell a rebuild from an edit.
    # Chrome stamps the wall clock into /CreationDate and /ModDate; print-page.mjs
    # rewrites them from SOURCE_DATE_EPOCH, which is set here from the paper's own
    # published date. The document's date is the honest thing for it to carry, and
    # it only moves when the paper does. An epoch already in the environment wins,
    # so a release process can pin it.
    env = dict(os.environ)
    env.setdefault("SOURCE_DATE_EPOCH", str(built["epoch"]))
    try:
        r = subprocess.run(["node", str(ROOT / "bin" / "print-page.mjs"),
                            str(page), str(tmp), *built["print_args"]],
                           capture_output=True, text=True, env=env)
        if r.returncode or not tmp.exists():
            sys.exit(f"PDF FAILED\n{r.stdout}\n{r.stderr}")
        print(f"  {r.stdout.strip()}")
        blob = tmp.read_bytes()
        # The rule fonts() enforces for the text, held for the whole file: every
        # face the PDF embeds is one of FACES. A figure loaded as an image once
        # printed in Avenir Next, Charter and Menlo with nothing to say so. Checked
        # before the move, so a refused render never replaces the tracked file.
        embedded = set(re.findall(rb"/(?:BaseFont|FontName)\s*/(?:[A-Z]{6}\+)?([A-Za-z0-9]+)", blob))
        allowed = {fam.replace(" ", "").encode() for fam, *_ in FACES}
        if not embedded or embedded - allowed:
            sys.exit(f"the render embeds " +
                     (", ".join(sorted(f.decode() for f in embedded - allowed))
                      if embedded else "no font this can read") +
                     f", outside the site's faces ({', '.join(sorted(a.decode() for a in allowed))}). "
                     f"Something is drawing text in a system font; {rel(out)} was not written.")
        os.replace(tmp, out)
    finally:
        tmp.unlink(missing_ok=True)

    pages = len(re.findall(rb"/Type\s*/Page[^s]", blob))
    print(f"wrote {rel(out)}  {len(blob):,} bytes · {pages} pages · {built['summary']}")

    if provenance:
        write_provenance(provenance, out, blob, pages, env["SOURCE_DATE_EPOCH"], draft)
        print(f"wrote {rel(provenance)}  {len(INPUTS)} recorded input(s)")


def same_path(a, b):
    """Whether two paths name one file, as the filesystem resolves them.

    samefile when both exist. Otherwise the resolved paths compared without case,
    which on a case-sensitive volume refuses a little more than it must, and
    never less: a guard that errs here errs towards refusing."""
    a, b = pathlib.Path(a), pathlib.Path(b)
    try:
        if a.exists() and b.exists():
            return os.path.samefile(a, b)
    except OSError:
        pass
    return str(a.resolve()).casefold() == str(b.resolve()).casefold()


def pdf_string(blob, key):
    """One of the PDF's own document-information strings, unescaped."""
    m = re.search(rb"/" + key.encode() + rb"\s*\((.*?)(?<!\\)\)", blob, re.S)
    return re.sub(r"\\([()\\])", r"\1", m.group(1).decode("latin1")) if m else ""


def write_provenance(path, out, blob, pages, epoch, draft=False):
    """Record what was built, from what, by what.

    The toolchain fields are read back out of the PDF rather than asked of the
    machine: /Producer and /Creator are the artifact's own statement about the
    browser and platform that made it, which is the thing a later reader needs and
    the thing that cannot be got wrong by querying the wrong binary. They are also
    what makes a failure legible — an artifact built by Skia/PDF m150 on macOS is
    not going to come out byte-identical under a different browser or a different
    kernel, and a check that knows both strings can say so instead of blaming the
    paper.

    A draft says so here as well as on its pages, so check-pdf-current can refuse
    a draft that reached the tracked path by a copy rather than by this script.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    doc = {
        "artifact": rel(out),
        "bytes": len(blob),
        "pages": pages,
        "sha256": hashlib.sha256(blob).hexdigest(),
        "source_date_epoch": epoch,
        "built_by": {"producer": pdf_string(blob, "Producer"),
                     "creator": pdf_string(blob, "Creator"),
                     "pandoc": PANDOC_VERSION[0] if PANDOC_VERSION else ""},
        "inputs": dict(sorted(INPUTS.items())),
    }
    if draft:
        doc["draft"] = True
    path.write_text(json.dumps(doc, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--paper", choices=sorted(PAPERS), default=DEFAULT,
                    help=f"which paper to render (default: {DEFAULT})")
    # --out exists so that a caller wanting to inspect a build never has to point
    # the renderer at the tracked file. check-pdf-reproducible used to rebuild over
    # static/whitepaper.pdf and copy the committed bytes back afterwards, which
    # made merely running the check a way to lose the deliverable. It now builds
    # somewhere else entirely, so there is no window to lose it in.
    ap.add_argument("--out", type=pathlib.Path, default=None,
                    help="where to write the PDF (default: the paper's tracked artifact, "
                         "static/whitepaper.pdf or static/software-factory.pdf)")
    ap.add_argument("--provenance", type=pathlib.Path, default=None,
                    help="where to write the build manifest "
                         "(default: the paper's pdf.provenance.json, and only when "
                         "--out is the tracked artifact)")
    ap.add_argument("--draft", action="store_true",
                    help="accept figures whose alt text is still a TODO, and stamp every "
                         "page as a draft; refused for the tracked artifact")
    args = ap.parse_args()
    paper = PAPERS[args.paper]
    out = args.out if args.out is not None else paper["out"]
    prov = args.provenance
    if prov is None and same_path(out, paper["out"]):
        prov = paper["provenance"]
    # Two ways to put the wrong file at a tracked path, both refused here rather
    # than caught later. A draft is for looking at: written to any paper's
    # tracked path it would be one `git add` from publishing a stamped, unfinished
    # paper. And one paper's render written over the other's artifact or manifest
    # is a self-consistent pair that describes the wrong document. The paths are
    # compared as the filesystem sees them, not as strings: on a case-insensitive
    # volume static/WHITEPAPER.pdf is static/whitepaper.pdf, and the string
    # comparison this replaced let a draft through by that route.
    for other, p in PAPERS.items():
        for kind, tracked, given in (("PDF", p["out"], out), ("manifest", p["provenance"], prov)):
            if given is None or not same_path(given, tracked):
                continue
            if args.draft:
                sys.exit(f"--draft cannot write {rel(tracked)}, a tracked {kind}. Pass --out "
                         f"(and --provenance, if you want one) somewhere else.")
            if other != args.paper:
                sys.exit(f"--paper {args.paper} cannot write {rel(tracked)}: that is the tracked "
                         f"{kind} of {other}.")
    preflight()
    render(args.paper, out, prov, args.draft)
