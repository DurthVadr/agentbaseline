  padding:0 0 1.6mm; margin:0 0 1.2mm; border-bottom:.5pt solid var(--rule); }
.deepen .key .lv { border-top:none; padding:.2mm 0; }
.deepen .key dd { font-family:"Figtree",sans-serif; font-size:8.5pt; color:var(--soft);
  line-height:1.4; text-wrap:wrap; }
.deepen .row { break-inside:avoid; margin:0 0 3mm; border-top:.5pt solid var(--rule); }
.deepen .comp { font-family:"Figtree",sans-serif; font-weight:600; font-size:10pt;
  line-height:1.3; margin:0; padding:1.8mm 0 1.2mm; text-align:left; }
.deepen dl { margin:0; }
.deepen .lv { display:grid; grid-template-columns:19mm 1fr; gap:0 4mm;
  padding:1.6mm 0 1.8mm; border-top:.4pt solid var(--line); }
.deepen dt { font-family:"IBM Plex Mono",monospace; font-weight:600; font-size:8pt;
  color:var(--accent); letter-spacing:.01em; padding-top:.3mm; }
