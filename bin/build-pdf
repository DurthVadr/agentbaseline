  text-wrap:balance; }

/* ── reference architecture: definitions ──────────────────────────────── */
/* A glossary, not a run of bold-led paragraphs: the term in the margin, so
   the eye can run down the terms, and an entry never splits from its term. */
dl.glossary { margin:3mm 0 0; }
